// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(uuid())
  name                    String
  username                String   @unique
  email                   String   @unique
  password                String
  avatar                  String   @default("🦉")
  grade                   String   @default("Kelas 1 SD")
  dailyGoalMinutes        Int      @default(10)
  role                    String   @default("student")
  xp                      Int      @default(0)
  hearts                  Int      @default(5)
  maxHearts               Int      @default(5)
  streak                  Int      @default(1)
  lastActiveDate          DateTime @default(now())
  completedLessonsByCourse Json?   // Stored as JSON object: { courseId: [lessonIds] }
  completedCheckpointsByCourse Json? // Stored as JSON object: { courseId: [checkpointIds] }
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  progressLogs            ProgressLog[]

  @@map("users")
}

model ProgressLog {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  lessonId   String?
  xpEarned   Int      @default(20)
  status     String   @default("completed") // completed, attempted
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_logs")
}

model Course {
  id              String   @id
  title           String
  description     String
  targetAudience  String
  category        String   @default("math")
  icon            String   @default("🔢")
  themeColor      String   @default("green")
  features        Json     // Array of string features
  isReady         Boolean  @default(true)
  units           Json     // Structured units, lessons, checkpoints, and exercises
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("courses")
}
